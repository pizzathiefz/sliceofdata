---
import Layout from "../../layouts/Layout.astro";
import { getCollection } from "astro:content";

const films = (
  await getCollection("films", ({ data }) => data.publish && data.created.getFullYear() >= 2017)
).sort((a, b) => b.data.created.valueOf() - a.data.created.valueOf());

const byYear = Object.groupBy(films, (f) => f.data.created.getFullYear());
const years = Object.keys(byYear)
  .map(Number)
  .sort((a, b) => b - a);
const latestYear = years[0];

function splitTitle(title: string) {
  const i = title.indexOf(";");
  if (i === -1) return { main: title, alt: null };
  return { main: title.slice(0, i).trim(), alt: title.slice(i + 1).trim() };
}
---

<Layout title="films">
  <h1>films</h1>

  <div class="year-tabs" role="tablist">
    {
      years.map((year) => (
        <button
          class="year-tab"
          data-year={year}
          aria-pressed={year === latestYear ? "true" : "false"}
        >
          {year}
        </button>
      ))
    }
  </div>

  {
    years.map((year) => (
      <div class="year-group" data-year={year} hidden={year !== latestYear}>
        <div class="year-count">
          <span class="line" />
          <span class="count-badge">
            <svg
              width="14"
              height="14"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <rect x="2" y="2" width="20" height="20" rx="2.18" ry="2.18" />
              <line x1="7" y1="2" x2="7" y2="22" />
              <line x1="17" y1="2" x2="17" y2="22" />
              <line x1="2" y1="12" x2="22" y2="12" />
              <line x1="2" y1="7" x2="7" y2="7" />
              <line x1="2" y1="17" x2="7" y2="17" />
              <line x1="17" y1="17" x2="22" y2="17" />
              <line x1="17" y1="7" x2="22" y2="7" />
            </svg>
            {byYear[year]!.length}
          </span>
          <span class="line" />
        </div>
        <ul class="film-list">
          {byYear[year]!.map((f) => {
            const { main, alt } = splitTitle(f.data.title);
            return (
              <li class="film-row">
                <span class="film-title">
                  {main}
                  {alt && <span class="film-title-alt">; {alt}</span>}
                </span>
                {f.data.comment && <span class="film-chip">{f.data.comment}</span>}
                <div class="film-meta">
                  {f.data.year != null && <span class="film-year">{f.data.year}</span>}
                  {f.data.rating != null && (
                    <span class="film-rating">
                      <span class="star">★</span>
                      {f.data.rating}
                    </span>
                  )}
                </div>
              </li>
            );
          })}
        </ul>
        <button class="load-more"><span class="more-text">more</span></button>
      </div>
    ))
  }
</Layout>

<style>
  .year-tabs {
    display: flex;
    column-gap: 1.1rem;
    row-gap: 0.2rem;
    margin-bottom: 1rem;
    flex-wrap: wrap;
  }
  .year-tab {
    background: none;
    background-repeat: no-repeat;
    border: none;
    padding: 0.1rem 0.15rem;
    font-family: var(--font-mono);
    font-size: 0.95rem;
    color: var(--muted);
    cursor: pointer;
  }
  .year-tab:hover {
    color: var(--fg);
  }
  .year-tab[aria-pressed="true"] {
    color: var(--fg);
    background-image: linear-gradient(
      180deg,
      transparent 0%,
      transparent 35%,
      var(--tab-highlight) 35%,
      var(--tab-highlight) 80%,
      transparent 80%
    );
  }

  .year-count {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin: 0 0 1.5rem;
  }
  .year-count .line {
    flex: 1;
    height: 0;
    border-top: 1px dotted var(--border);
  }
  .count-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-family: var(--font-mono);
    font-weight: 400;
    color: var(--muted);
    font-size: 0.85rem;
    white-space: nowrap;
  }
  .film-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .film-row {
    display: grid;
    grid-template-columns: 9rem 26rem;
    justify-content: start;
    grid-template-rows: auto auto;
    column-gap: 1.5rem;
    row-gap: 0.2rem;
    padding: 0.9rem 0;
    border-bottom: 1px solid var(--border);
  }
  .film-row:first-child {
    border-top: 1px solid var(--border);
  }
  .film-row[hidden] {
    display: none;
  }
  .film-title {
    grid-column: 1;
    grid-row: 1;
    align-self: start;
    font-weight: 600;
    font-size: 0.92rem;
    line-height: 1.35;
  }
  .film-title-alt {
    display: block;
    font-weight: 400;
    font-size: 0.9em;
    color: var(--muted);
  }
  .film-chip {
    grid-column: 2;
    grid-row: 1 / span 2;
    align-self: start;
    padding: 0.2rem 0.5rem;
    font-size: 0.8rem;
    border: 1px solid var(--border);
    border-radius: 3px;
    background-color: var(--chip-bg);
  }
  .film-meta {
    grid-column: 1;
    grid-row: 2;
    align-self: start;
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
  }
  .film-year {
    font-family: var(--font-mono);
    font-weight: 400;
    color: var(--muted);
    font-size: 0.75rem;
  }
  .film-rating {
    display: inline-flex;
    align-items: baseline;
    gap: 0.2em;
    font-family: var(--font-mono);
    color: var(--accent);
    font-size: 0.7rem;
  }
  .film-rating .star {
    font-size: 1.4em;
    line-height: 1;
  }

  .load-more {
    display: flex;
    align-items: center;
    justify-content: center;
    width: fit-content;
    margin: 1.5rem auto 0;
    padding: 0.22rem 0.65rem;
    border: 1px solid var(--border);
    border-radius: 0;
    appearance: none;
    -webkit-appearance: none;
    background: none;
    font-family: var(--font-mono);
    font-size: 0.9rem;
    color: var(--fg);
    cursor: pointer;
  }
  .load-more:hover {
    border-color: var(--fg);
  }
  .load-more[hidden] {
    display: none;
  }

  @media (max-width: 600px) {
    .film-row {
      grid-template-columns: 1fr;
      grid-template-rows: auto auto auto;
      row-gap: 0.4rem;
    }
    .film-title {
      grid-row: 1;
      max-width: none;
    }
    .film-chip {
      grid-column: 1;
      grid-row: 3;
      justify-self: stretch;
      width: auto;
    }
    .film-meta {
      grid-row: 2;
    }
  }
</style>

<script>
  const PAGE_SIZE = 20;

  const tabs = document.querySelectorAll<HTMLButtonElement>(".year-tab");
  const groups = document.querySelectorAll<HTMLDivElement>(".year-group");

  function showYear(year: string) {
    groups.forEach((g) => {
      g.hidden = g.dataset.year !== year;
    });
    tabs.forEach((t) => {
      t.setAttribute("aria-pressed", String(t.dataset.year === year));
    });
  }

  tabs.forEach((tab) => {
    tab.addEventListener("click", () => showYear(tab.dataset.year!));
  });

  groups.forEach((group) => {
    const rows = Array.from(group.querySelectorAll<HTMLLIElement>(".film-row"));
    const btn = group.querySelector<HTMLButtonElement>(".load-more")!;
    let visible = PAGE_SIZE;

    function render() {
      rows.forEach((row, i) => {
        row.hidden = i >= visible;
      });
      btn.hidden = visible >= rows.length;
    }

    btn.addEventListener("click", () => {
      visible += PAGE_SIZE;
      render();
    });

    render();
  });
</script>
