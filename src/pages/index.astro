---
import Layout from "../layouts/Layout.astro";
import { getCollection } from "astro:content";

// per-day counts of everything published, keyed "YYYY-MM-DD"
const kinds = ["posts", "notes", "books", "films"] as const;
const activity: Record<string, Record<string, number>> = {};
// linkable entries as [kind, title, href, date], for the sample cell
const items: [string, string, string, string][] = [];
const stripCompany = (title: string) => title.replace(/\s+@[^@]+$/, "");
for (const kind of kinds) {
  const entries = await getCollection(kind, ({ data }) => data.publish);
  for (const entry of entries) {
    const day = entry.data.created.toISOString().slice(0, 10);
    activity[day] ??= {};
    activity[day][kind] = (activity[day][kind] ?? 0) + 1;
    // films have no detail page, and books without a write-up aren't worth a click
    if (kind === "films") continue;
    if (kind === "books" && !entry.body?.replace(/-{3,}/g, "").trim()) continue;
    // rating 0 means unrated, so only real low scores are skipped; older reads are left out too
    if (kind === "books") {
      const rating = (entry.data as { rating?: number }).rating ?? 0;
      if (rating > 0 && rating < 3) continue;
      if (day < "2021-01-01") continue;
    }
    const title = kind === "notes" ? stripCompany(entry.data.title) : entry.data.title;
    items.push([kind.slice(0, -1), title, `/${kind}/${entry.id}`, day]);
  }
}
---

<Layout title="home">
  <div class="home">
    <div class="notebook">
      <div class="prompt">[ ]:</div>
      <div class="cell md">
        <h1><span class="hash">#</span> slice.of.data</h1>
        <p class="tagline">Half data, half everything else. Served one slice at a time.</p>
      </div>

      <div class="prompt start">[1]:</div>
      <div class="cell code">
        <code class="expr" id="heatmap-expr"></code>
      </div>
      <div class="output">
        <div class="grid" id="heatmap-grid" data-activity={JSON.stringify(activity)}>
          <div class="selection" id="heatmap-selection" hidden></div>
        </div>
        <div class="out" id="heatmap-out"></div>
      </div>

      <div class="prompt-row start">
        <div class="prompt" id="sample-in">[2]:</div>
        <button class="run" id="sample-run" aria-label="Run cell" title="Run cell">
          <svg
            width="17"
            height="17"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <polygon points="6 4 20 12 6 20 6 4" />
          </svg>
        </button>
      </div>
      <div class="cell code">
        <code class="expr"
          ><span class="ps">&gt;&gt;&gt;</span> <span class="var">data</span>.sample(<span class="num">10</span>)</code
        >
      </div>
      <div class="output">
        <div class="dialog">
          <svg class="frame" aria-hidden="true"></svg>
          <p class="dialog-title">You found 10 slices!</p>
          <div class="chips" id="sample-out" data-items={JSON.stringify(items)}></div>
        </div>
      </div>

      <div class="prompt start">[3]:</div>
      <div class="cell code">
        <code class="expr"
          ><span class="ps">&gt;&gt;&gt;</span> pprint(<span class="var">about</span>)</code
        >
      </div>
      <div class="output">
        <div class="dialog">
          <svg class="frame" aria-hidden="true"></svg>
          <dl class="kv">
            <dt>name</dt>
            <dd>Youngshin Son</dd>
            <dt>lv</dt>
            <dd>???</dd>
            <dt>class</dt>
            <dd>ML Engineer</dd>
            <dt>passive</dt>
            <dd class="passive">Makes things people enjoy, and makes a point of enjoying it.</dd>
          </dl>
          <div class="choices" role="group" aria-label="Contact">
            <a href="https://www.linkedin.com/in/youngshin-son/" target="_blank" rel="noopener"
              ><span class="cursor" aria-hidden="true">▶</span>linkedin</a
            >
            <a href="https://github.com/pizzathiefz" target="_blank" rel="noopener"
              ><span class="cursor" aria-hidden="true">▶</span>github</a
            >
            <a href="mailto:pizzathief0@gmail.com"
              ><span class="cursor" aria-hidden="true">▶</span>email</a
            >
          </div>
        </div>
      </div>
    </div>
  </div>
</Layout>

<script>
  const KINDS = ["posts", "notes", "books", "films"];
  const mobile = matchMedia("(max-width: 480px)");

  const grid = document.getElementById("heatmap-grid")!;
  const selectionBox = document.getElementById("heatmap-selection")!;
  const expr = document.getElementById("heatmap-expr")!;
  const out = document.getElementById("heatmap-out")!;
  const activity: Record<string, Record<string, number>> = JSON.parse(grid.dataset.activity!);

  // dates are handled as UTC days so keys match the frontmatter dates
  const now = new Date();
  const today = new Date(Date.UTC(now.getFullYear(), now.getMonth(), now.getDate()));
  const todayKey = keyOf(today);

  let weeks = 0;
  let start = today;
  let cells: HTMLElement[][] = [];

  function keyOf(d: Date) {
    return d.toISOString().slice(0, 10);
  }
  function dayKey(week: number, weekday: number) {
    const d = new Date(start);
    d.setUTCDate(start.getUTCDate() + week * 7 + weekday);
    return keyOf(d);
  }
  function total(key: string) {
    return Object.values(activity[key] ?? {}).reduce((a, b) => a + b, 0);
  }
  // "2026-05-03" -> "260503"
  function label(key: string) {
    return key.slice(2).replaceAll("-", "");
  }

  function render() {
    weeks = mobile.matches ? 26 : 53;
    start = new Date(today);
    start.setUTCDate(today.getUTCDate() - (weeks - 1) * 7 - today.getUTCDay());
    grid.style.gridTemplateColumns = `repeat(${weeks}, 1fr)`;
    cells.flat().forEach((c) => c.remove());
    cells = [];
    for (let w = 0; w < weeks; w++) {
      cells.push([]);
      for (let d = 0; d < 7; d++) {
        const key = dayKey(w, d);
        const n = total(key);
        const cell = document.createElement("span");
        cell.className = "cell";
        cell.dataset.week = String(w);
        cell.dataset.key = key;
        cell.dataset.level = String(n === 0 ? 0 : n === 1 ? 1 : n <= 3 ? 2 : 3);
        if (key > todayKey) cell.classList.add("future");
        cell.style.gridColumn = String(w + 1);
        cell.style.gridRow = String(d + 1);
        grid.appendChild(cell);
        cells[w].push(cell);
      }
    }
  }

  const str = (s: string) => `<span class="str">'${s}'</span>`;

  // sum activity between two keys (inclusive) and print it like a REPL
  function describe(index: string, from: string, to: string) {
    const counts: Record<string, number> = {};
    for (const [key, byKind] of Object.entries(activity)) {
      if (key < from || key > to) continue;
      for (const [kind, n] of Object.entries(byKind)) counts[kind] = (counts[kind] ?? 0) + n;
    }
    const sum = Object.values(counts).reduce((a, b) => a + b, 0);
    const parts = KINDS.filter((k) => counts[k]).map(
      (k) => `<a href="/${k}">${counts[k]} ${counts[k] === 1 ? k.slice(0, -1) : k}</a>`,
    );
    expr.innerHTML = `<span class="ps">&gt;&gt;&gt;</span> <span class="var">data</span>[${index}]`;
    out.innerHTML =
      `${sum} slice${sum === 1 ? "" : "s"}` +
      (parts.length ? ` <span class="sep">|</span> ${parts.join(" · ")}` : "");
  }

  const weekStart = (w: number) => dayKey(w, 0);
  const weekEnd = (w: number) => {
    const key = dayKey(w, 6);
    return key > todayKey ? todayKey : key;
  };
  const showRange = (from: string, to: string) =>
    describe(`${str(label(from))}:${str(label(to))}`, from, to);

  let anchor: number | null = null;
  let range: [number, number] | null = null;

  // the weeks covering the last 30 days, selected by default
  function selectRecent() {
    const days = Math.round((today.getTime() - start.getTime()) / 86400000);
    select(Math.floor((days - 29) / 7), weeks - 1);
  }

  function select(a: number, b: number) {
    const [lo, hi] = a <= b ? [a, b] : [b, a];
    range = [lo, hi];
    grid.classList.add("selecting");
    cells.forEach((col, w) => col.forEach((c) => c.classList.toggle("in", w >= lo && w <= hi)));
    const first = cells[lo][0];
    const last = cells[hi][6];
    selectionBox.hidden = false;
    selectionBox.style.left = `${first.offsetLeft - 3}px`;
    selectionBox.style.top = `${first.offsetTop - 3}px`;
    selectionBox.style.width = `${last.offsetLeft + last.offsetWidth - first.offsetLeft + 6}px`;
    selectionBox.style.height = `${last.offsetTop + last.offsetHeight - first.offsetTop + 6}px`;
    showRange(weekStart(lo), weekEnd(hi));
  }

  function weekAt(e: PointerEvent) {
    const el = document.elementFromPoint(e.clientX, e.clientY) as HTMLElement | null;
    return el?.dataset.week !== undefined ? Number(el.dataset.week) : null;
  }

  grid.addEventListener("pointerdown", (e) => {
    const w = weekAt(e);
    if (w === null) return;
    // clicking inside the current single-week selection resets it
    if (range && range[0] === w && range[1] === w) {
      selectRecent();
      return;
    }
    anchor = w;
    grid.setPointerCapture(e.pointerId);
    select(w, w);
  });
  grid.addEventListener("pointermove", (e) => {
    if (anchor === null) return;
    const w = weekAt(e);
    if (w !== null) select(anchor, w);
  });
  grid.addEventListener("pointerup", () => (anchor = null));
  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape") selectRecent();
  });
  window.addEventListener("resize", () => range && select(...range));
  mobile.addEventListener("change", () => {
    render();
    selectRecent();
  });

  render();
  selectRecent();

  // [2]: shown as data.sample(10), but drawn as 1–2 posts + 1–3 books + notes for the rest
  // — re-running bumps the execution count like Jupyter
  const SAMPLE_SIZE = 10;
  const randInt = (lo: number, hi: number) => lo + Math.floor(Math.random() * (hi - lo + 1));
  const sampleOut = document.getElementById("sample-out")!;
  const sampleIn = document.getElementById("sample-in")!;
  const items: [string, string, string, string][] = JSON.parse(sampleOut.dataset.items!);
  // dialog frames: two 1px lines with stepped, pixel-style corners
  function steppedRect(o: number, w: number, h: number, s = 3) {
    const [l, t, r, b] = [o, o, w - o, h - o];
    return (
      `M${l + 2 * s},${t}H${r - 2 * s}V${t + s}H${r - s}V${t + 2 * s}H${r}` +
      `V${b - 2 * s}H${r - s}V${b - s}H${r - 2 * s}V${b}` +
      `H${l + 2 * s}V${b - s}H${l + s}V${b - 2 * s}H${l}` +
      `V${t + 2 * s}H${l + s}V${t + s}H${l + 2 * s}Z`
    );
  }
  function drawFrame(dialog: Element) {
    const frame = dialog.querySelector(".frame")!;
    const { width: w, height: h } = dialog.getBoundingClientRect();
    frame.setAttribute("viewBox", `0 0 ${w} ${h}`);
    frame.innerHTML = [0.5, 4.5]
      .map((o) => `<path d="${steppedRect(o, w, h)}" fill="none" stroke="currentColor" />`)
      .join("");
  }
  const frameObserver = new ResizeObserver((entries) => entries.forEach((e) => drawFrame(e.target)));
  document.querySelectorAll(".dialog").forEach((d) => frameObserver.observe(d));

  // [3] has already run, so re-running [2] continues from [4]
  let runCount = 3;

  function shuffle<T>(arr: T[]) {
    for (let i = arr.length - 1; i > 0; i--) {
      const j = Math.floor(Math.random() * (i + 1));
      [arr[i], arr[j]] = [arr[j], arr[i]];
    }
    return arr;
  }

  // books and notes lean recent, stepping by year: this year 3x, last year 2x, older 1x
  function weight([kind, , , day]: (typeof items)[number]) {
    if (kind === "post") return 1;
    const yearsAgo = today.getUTCFullYear() - Number(day.slice(0, 4));
    return Math.max(1, 3 - yearsAgo);
  }

  // weighted sampling without replacement (Efraimidis–Spirakis keys)
  function weightedSample<T>(pool: T[], n: number, w: (item: T) => number) {
    return pool
      .map((item) => ({ item, key: Math.random() ** (1 / w(item)) }))
      .sort((a, b) => b.key - a.key)
      .slice(0, n)
      .map(({ item }) => item);
  }

  // hrefs shown in the last two runs, kept out of the next draw so re-runs feel fresh
  const recentRuns: Set<string>[] = [];

  function sample() {
    const posts = randInt(1, 2);
    const books = randInt(1, 3);
    const quota = { post: posts, book: books, note: SAMPLE_SIZE - posts - books };
    const seen = (item: (typeof items)[number]) => recentRuns.some((run) => run.has(item[2]));
    const picked = Object.entries(quota).flatMap(([kind, n]) => {
      const pool = items.filter((item) => item[0] === kind);
      const fresh = pool.filter((item) => !seen(item));
      return weightedSample(fresh.length >= n ? fresh : pool, n, weight);
    });
    recentRuns.unshift(new Set(picked.map((item) => item[2])));
    recentRuns.length = Math.min(recentRuns.length, 2);
    sampleOut.replaceChildren(
      ...shuffle(picked).map(([kind, title, href]) => {
        const chip = document.createElement("a");
        chip.className = `chip ${kind}`;
        chip.href = href;
        chip.dataset.title = title;
        const text = document.createElement("span");
        text.className = "text";
        text.textContent = title;
        chip.appendChild(text);
        return chip;
      }),
    );
    markClipped();
  }

  // only clipped titles get the hover tooltip
  function markClipped() {
    for (const chip of sampleOut.children as HTMLCollectionOf<HTMLElement>) {
      const text = chip.querySelector(".text")!;
      chip.classList.toggle("clipped", text.scrollWidth > text.clientWidth);
    }
  }
  window.addEventListener("resize", markClipped);

  document.getElementById("sample-run")!.addEventListener("click", () => {
    runCount++;
    sampleIn.textContent = `[${runCount}]:`;
    sample();
  });
  sample();
</script>

<style>
  .home {
    min-height: 60vh;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
  }
  .notebook {
    width: 100%;
    max-width: 640px;
    text-align: left;
  }
  .start {
    margin-top: 1.8rem;
  }
  .prompt {
    margin-bottom: 0.3rem;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    color: var(--muted);
  }
  .prompt-row {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    margin-bottom: 0.3rem;
  }
  .prompt-row .prompt {
    margin-bottom: 0;
  }
  .cell.md {
    padding: 0.35rem 0 0.35rem 1rem;
    border-left: 2px solid var(--border);
  }
  .cell.code {
    padding: 0.5rem 0.85rem;
    background: var(--chip-bg);
    border: 1px solid var(--border);
    border-radius: 4px;
    overflow-x: auto;
  }
  .expr :global(.ps),
  .expr .ps {
    margin-right: 0.15em;
    color: var(--muted);
  }
  .cell h1 {
    margin: 0;
    font-size: 0.95rem;
    color: color-mix(in srgb, var(--fg) 75%, var(--muted));
  }
  .hash {
    margin-right: 0.2em;
    color: var(--muted);
    font-weight: 400;
  }
  .tagline {
    margin: 0.2rem 0 0;
    font-family: var(--font-mono);
    font-style: italic;
    font-size: 0.75rem;
    color: var(--muted);
    word-spacing: -0.2em;
  }
  .run {
    padding: 0;
    border: 0;
    background: none;
    color: color-mix(in srgb, var(--fg) 50%, var(--muted));
    line-height: 0;
    cursor: pointer;
  }
  .run:hover {
    color: var(--accent);
  }
  .chips {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.15rem 1.2rem;
  }
  @media (max-width: 480px) {
    .chips {
      grid-template-columns: minmax(0, 1fr);
    }
  }
  .dialog-title {
    margin: 0 0 0.6rem;
    font-family: var(--font-mono);
    font-size: 0.74rem;
    color: var(--muted);
  }
  .chips :global(.chip) {
    --kind: var(--accent);
    display: flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.15rem 0;
    font-family: var(--font-mono);
    font-size: 0.74rem;
    color: color-mix(in srgb, var(--fg) 65%, var(--muted));
    text-decoration: none;
  }
  .chips :global(.chip.post) {
    --kind: #c98a2b;
  }
  .chips :global(.chip.note) {
    --kind: #3f9d6b;
  }
  .chips :global(.chip) {
    position: relative;
  }
  .chips :global(.chip.clipped)::after {
    content: attr(data-title);
    position: absolute;
    bottom: calc(100% + 6px);
    left: 0;
    z-index: 10;
    width: max-content;
    max-width: min(22rem, 80vw);
    padding: 0.35rem 0.6rem;
    border-radius: 4px;
    background: var(--fg);
    color: var(--bg);
    font-size: 0.72rem;
    line-height: 1.4;
    white-space: normal;
    opacity: 0;
    transform: translateY(3px);
    transition:
      opacity 0.15s,
      transform 0.15s;
    pointer-events: none;
  }
  /* right-column tooltips grow leftward so they never push past the page edge */
  .chips :global(.chip:nth-child(2n).clipped)::after {
    left: auto;
    right: 0;
  }
  @media (max-width: 480px) {
    .chips :global(.chip:nth-child(2n).clipped)::after {
      left: 0;
      right: auto;
    }
    .chips :global(.chip.clipped)::after {
      max-width: 100%;
    }
  }
  .chips :global(.chip.clipped:hover)::after {
    opacity: 1;
    transform: translateY(0);
  }
  .chips :global(.chip .text) {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  /* ▶ cursor: grey when resting on the first choice, category color on hover/focus */
  .chips :global(.chip)::before {
    content: "▶";
    flex: 0 0 0.9em;
    font-size: 0.62rem;
    text-align: center;
    visibility: hidden;
  }
  .chips:not(:hover):not(:focus-within) :global(.chip:first-child)::before {
    visibility: visible;
    color: var(--muted);
    animation: blink 1s steps(1) infinite;
  }
  .chips :global(.chip:hover)::before,
  .chips :global(.chip:focus-visible)::before {
    visibility: visible;
    color: var(--kind);
    animation: blink 1s steps(1) infinite;
  }
  /* touch screens can't hover: show every cursor in its category color, steady */
  @media (hover: none) {
    .chips :global(.chip)::before,
    .chips:not(:hover):not(:focus-within) :global(.chip:first-child)::before {
      visibility: visible;
      color: var(--kind);
      animation: none;
    }
  }
  .chips :global(.chip:hover),
  .chips :global(.chip:focus-visible) {
    color: var(--fg);
    outline: none;
  }
  .kv {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    column-gap: 1.1rem;
    row-gap: 0.35rem;
    margin: 0;
    font-family: var(--font-mono);
    font-size: 0.74rem;
    line-height: 1.5;
  }
  .kv dt {
    color: color-mix(in srgb, var(--muted) 65%, var(--bg));
  }
  .kv dd {
    margin: 0;
    color: color-mix(in srgb, var(--fg) 65%, var(--muted));
  }
  /* keep the passive on one line wherever there's room; phones may wrap */
  @media (min-width: 700px) {
    .kv .passive {
      white-space: nowrap;
    }
  }
  /* retro RPG dialog box: double border, links as a choice menu */
  .dialog {
    --dialog-line: color-mix(in srgb, var(--muted) 70%, var(--bg));
    padding: 0.9rem 1.1rem 0.8rem;
    position: relative;
  }
  .frame {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    color: var(--dialog-line);
    pointer-events: none;
    shape-rendering: crispEdges;
  }
  .choices {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 1.6rem;
    margin-top: 0.9rem;
    padding-top: 0.7rem;
    border-top: 1px dashed var(--border);
    font-family: var(--font-mono);
    font-size: 0.74rem;
  }
  .choices a {
    color: color-mix(in srgb, var(--fg) 65%, var(--muted));
    text-decoration: none;
  }
  .choices a:hover,
  .choices a:focus-visible {
    color: var(--fg);
    outline: none;
  }
  .cursor {
    display: inline-block;
    width: 1.2em;
    font-size: 0.7em;
    color: var(--accent);
    visibility: hidden;
  }
  /* the cursor rests on the first choice and follows hover/focus */
  .choices:not(:hover):not(:focus-within) a:first-child .cursor,
  .choices a:hover .cursor,
  .choices a:focus-visible .cursor {
    visibility: visible;
    animation: blink 1s steps(1) infinite;
  }
  @media (hover: none) {
    .choices .cursor {
      visibility: visible;
      animation: none;
    }
  }
  @keyframes blink {
    50% {
      opacity: 0;
    }
  }

  .grid {
    position: relative;
    display: grid;
    grid-template-rows: repeat(7, auto);
    gap: 2px;
    cursor: crosshair;
    user-select: none;
    touch-action: pan-y;
  }
  .grid :global(.cell) {
    aspect-ratio: 1;
    border-radius: 1px;
    background: color-mix(in srgb, var(--fg) 9%, var(--bg));
    transition: opacity 0.15s;
  }
  .grid :global(.cell[data-level="1"]) {
    background: color-mix(in srgb, var(--accent) 45%, var(--bg));
  }
  .grid :global(.cell[data-level="2"]) {
    background: color-mix(in srgb, var(--accent) 75%, var(--bg));
  }
  .grid :global(.cell[data-level="3"]) {
    background: var(--accent);
  }
  .grid :global(.cell.future) {
    visibility: hidden;
  }
  .grid.selecting :global(.cell:not(.in)) {
    opacity: 0.45;
  }
  .selection {
    position: absolute;
    border: 1px solid var(--accent);
    border-radius: 2px;
    pointer-events: none;
  }
  .output {
    margin-top: 0.75rem;
    padding-left: calc(0.8rem + 2px);
  }
  .expr {
    display: block;
    padding: 0;
    background: none;
    font-family: var(--font-mono);
    font-size: 0.74rem;
    color: var(--fg);
