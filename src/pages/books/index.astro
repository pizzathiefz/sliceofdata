---
import Layout from "../../layouts/Layout.astro";
import { getCollection } from "astro:content";

const books = (await getCollection("books", ({ data }) => data.publish)).sort(
  (a, b) => b.data.created.valueOf() - a.data.created.valueOf()
);

const byYear = Object.groupBy(books, (b) => b.data.created.getFullYear());
const years = Object.keys(byYear)
  .map(Number)
  .sort((a, b) => b - a);
const latestYear = years[0];

// Cleaned up for payload sanity only — actual visual truncation is done
// responsively in the browser (CSS line-clamp + overflow detection), since a
// fixed character budget doesn't track a box whose width can change.
const PREVIEW_CAP = 2000;

function previewText(body: string) {
  const clean = body
    .replace(/^#+\s*/gm, "")
    .replace(/🔖/g, "")
    .replace(/\*\*/g, "")
    .replace(/^\s*-{3,}\s*$/gm, " ✦ ")
    .replace(/\s+/g, " ")
    .trim();
  return clean.slice(0, PREVIEW_CAP);
}
---

<Layout title="books">
  <h1>books</h1>

  <div class="year-tabs" role="tablist">
    {
      years.map((year) => (
        <button
          class="year-tab"
          data-year={year}
          aria-pressed={year === latestYear ? "true" : "false"}
        >
          {year}
        </button>
      ))
    }
  </div>

  {
    years.map((year) => (
      <div class="year-group" data-year={year} hidden={year !== latestYear}>
        <div class="year-count">
          <span class="line" />
          <span class="count-badge">
            <svg
              width="14"
              height="14"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z" />
              <path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z" />
            </svg>
            {byYear[year]!.length}
          </span>
          <span class="line" />
        </div>
        <ul class="book-list">
          {byYear[year]!.map((b) => {
            const text = previewText(b.body ?? "");
            return (
              <li class="book-row">
                <a
                  class="book-link"
                  href={`/books/${b.id}`}
                  data-empty={text ? undefined : "true"}
                >
                  <div class="book-left">
                    <div class="book-title">{b.data.title}</div>
                    {b.data.author && <div class="book-author">{b.data.author}</div>}
                  </div>
                  <div class="book-chip">
                    {text && <span class="chip-text">{text}</span>}
                    <svg
                      class="more-icon"
                      hidden={!!text}
                      width="15"
                      height="15"
                      viewBox="0 0 24 24"
                      fill="currentColor"
                    >
                      <circle cx="5" cy="12" r="2" />
                      <circle cx="12" cy="12" r="2" />
                      <circle cx="19" cy="12" r="2" />
                    </svg>
                  </div>
                </a>
              </li>
            );
          })}
        </ul>
        <button class="load-more"><span class="more-text">more</span></button>
      </div>
    ))
  }

  <div class="toast" role="status"></div>
</Layout>

<style>
  .year-tabs {
    display: flex;
    column-gap: 1.1rem;
    row-gap: 0.2rem;
    margin-bottom: 1rem;
    flex-wrap: wrap;
  }
  .year-tab {
    background: none;
    background-repeat: no-repeat;
    border: none;
    padding: 0.1rem 0.15rem;
    font-family: var(--font-sans);
    font-size: 0.95rem;
    color: var(--muted);
    cursor: pointer;
  }
  .year-tab:hover {
    color: var(--fg);
  }
  .year-tab[aria-pressed="true"] {
    color: var(--fg);
    background-image: linear-gradient(
      180deg,
      transparent 0%,
      transparent 35%,
      var(--tab-highlight) 35%,
      var(--tab-highlight) 80%,
      transparent 80%
    );
  }

  .year-count {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin: 0 0 1.5rem;
  }
  .year-count .line {
    flex: 1;
    height: 0;
    border-top: 1px dotted var(--border);
  }
  .count-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-family: var(--font-mono);
    font-weight: 400;
    color: var(--muted);
    font-size: 0.85rem;
    white-space: nowrap;
  }

  .book-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .book-row {
    border-bottom: 1px solid var(--border);
  }
  .book-row:first-child {
    border-top: 1px solid var(--border);
  }
  .book-row[hidden] {
    display: none;
  }
  .book-link {
    display: grid;
    grid-template-columns: 9rem 26rem;
    column-gap: 1.5rem;
    align-items: start;
    padding: 0.9rem 0;
    text-decoration: none;
    color: inherit;
  }
  .book-left {
    min-width: 0;
  }
  .book-title {
    font-weight: 600;
    font-size: 0.92rem;
    line-height: 1.35;
  }
  .book-author {
    margin-top: 0.3rem;
    font-family: var(--font-mono);
    font-weight: 400;
    color: var(--muted);
    font-size: 0.75rem;
  }
  .book-chip {
    min-width: 0;
    border: 1px solid var(--border);
    border-radius: 3px;
    background-color: var(--chip-bg);
    padding: 0.5rem 0.7rem;
    font-size: 0.8rem;
    line-height: 1.6;
  }
  .chip-text {
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 7;
    line-clamp: 7;
    overflow: hidden;
    text-overflow: clip;
  }
  .book-chip .more-icon {
    display: block;
    margin-top: 0.4rem;
    color: var(--muted);
  }
  .book-chip .more-icon[hidden] {
    display: none;
  }
  .book-link:hover .book-title {
    color: var(--accent);
  }

  .load-more {
    display: flex;
    align-items: center;
    justify-content: center;
    width: fit-content;
    margin: 1.5rem auto 0;
    padding: 0.22rem 0.65rem;
    border: 1px solid var(--border);
    border-radius: 0;
    appearance: none;
    -webkit-appearance: none;
    background: none;
    font-family: var(--font-mono);
    font-size: 0.9rem;
    color: var(--fg);
    cursor: pointer;
  }
  .load-more:hover {
    border-color: var(--fg);
  }
  .load-more[hidden] {
    display: none;
  }

  @media (max-width: 600px) {
    .book-link {
      grid-template-columns: 1fr;
      row-gap: 0.5rem;
    }
    .book-chip {
      width: 100%;
    }
  }

  .toast {
    position: fixed;
    left: 0;
    top: 0;
    transform: translate(-50%, calc(-100% - 0.6rem)) translateY(0.4rem);
    border: 1px solid var(--border);
    background: var(--chip-bg);
    color: var(--fg);
    padding: 0.5rem 0.9rem;
    font-family: var(--font-mono);
    font-size: 0.8rem;
    white-space: nowrap;
    opacity: 0;
    pointer-events: none;
    transition:
      opacity 0.15s ease,
      transform 0.15s ease;
    z-index: 10;
  }
  .toast.show {
    opacity: 1;
    transform: translate(-50%, calc(-100% - 0.6rem)) translateY(0);
  }
</style>

<script>
  const PAGE_SIZE = 15;

  const tabs = document.querySelectorAll<HTMLButtonElement>(".year-tab");
  const groups = document.querySelectorAll<HTMLDivElement>(".year-group");

  function updateMoreIcons() {
    document.querySelectorAll<HTMLElement>(".chip-text").forEach((el) => {
      if (el.closest<HTMLElement>(".year-group")!.hidden) return;
      if (el.closest<HTMLElement>(".book-row")!.hidden) return;
      const icon = el.parentElement!.querySelector<HTMLElement>(".more-icon")!;
      icon.hidden = el.scrollHeight <= el.clientHeight + 1;
    });
  }

  function showYear(year: string) {
    groups.forEach((g) => {
      g.hidden = g.dataset.year !== year;
    });
    tabs.forEach((t) => {
      t.setAttribute("aria-pressed", String(t.dataset.year === year));
    });
    updateMoreIcons();
  }

  tabs.forEach((tab) => {
    tab.addEventListener("click", () => {
      const year = tab.dataset.year!;
      showYear(year);
      history.replaceState(null, "", `#${year}`);
    });
  });

  const hashYear = location.hash.slice(1);
  if (hashYear && [...tabs].some((t) => t.dataset.year === hashYear)) {
    showYear(hashYear);
  }

  groups.forEach((group) => {
    const rows = Array.from(group.querySelectorAll<HTMLLIElement>(".book-row"));
    const btn = group.querySelector<HTMLButtonElement>(".load-more")!;
    let visible = PAGE_SIZE;

    function render() {
      rows.forEach((row, i) => {
        row.hidden = i >= visible;
      });
      btn.hidden = visible >= rows.length;
      updateMoreIcons();
    }

    btn.addEventListener("click", () => {
      visible += PAGE_SIZE;
      render();
    });

    render();
  });

  const toast = document.querySelector<HTMLDivElement>(".toast")!;
  let toastTimer: ReturnType<typeof setTimeout>;

  function showToast(message: string, x: number, y: number) {
    toast.textContent = message;
    toast.style.left = `${x}px`;
    toast.style.top = `${y}px`;
    toast.classList.add("show");
    clearTimeout(toastTimer);
    toastTimer = setTimeout(() => toast.classList.remove("show"), 1600);
  }

  document.querySelectorAll<HTMLAnchorElement>(".book-link[data-empty]").forEach((link) => {
    link.addEventListener("click", (e) => {
      e.preventDefault();
      showToast("📭 this page doesn't exist", e.clientX, e.clientY);
    });
  });

  updateMoreIcons();
  document.fonts.ready.then(updateMoreIcons);
  let resizeTimer: ReturnType<typeof setTimeout>;
  window.addEventListener("resize", () => {
    clearTimeout(resizeTimer);
    resizeTimer = setTimeout(updateMoreIcons, 150);
  });
</script>
