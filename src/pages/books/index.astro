---
import Layout from "../../layouts/Layout.astro";
import { getCollection } from "astro:content";

const books = (await getCollection("books", ({ data }) => data.publish)).sort(
  (a, b) => b.data.created.valueOf() - a.data.created.valueOf()
);

const byYear = Object.groupBy(books, (b) => b.data.created.getFullYear());
const years = Object.keys(byYear)
  .map(Number)
  .sort((a, b) => b - a);
const latestYear = years[0];

// Cleaned up for payload sanity only — actual visual truncation is done
// responsively in the browser (CSS line-clamp + overflow detection), since a
// fixed character budget doesn't track a box whose width can change.
const PREVIEW_CAP = 2000;

function previewText(body: string) {
  const clean = body
    .replace(/^#+\s*/gm, "")
    .replace(/\*\*/g, "")
    .replace(/^\s*-{3,}\s*$/gm, "✦")
    .replace(/[🔖💬]/g, "✦")
    .replace(/\s+/g, " ")
    .replace(/✦(?:\s*✦)+/g, "✦")
    .trim()
    .replace(/^✦\s*/, "")
    .replace(/\s*✦$/, "");
  return clean.slice(0, PREVIEW_CAP);
}

const recommendedBooks = books.filter(
  (b) => (b.data.rating ?? 0) >= 4 && previewText(b.body ?? "").length > 0
);
const RECOMMEND_COUNT = 10;
const showRefresh = recommendedBooks.length > RECOMMEND_COUNT;

const defaultTab = recommendedBooks.length > 0 ? "recommend" : String(latestYear);
---

<Layout title="books">
  <h1>books</h1>

  <div class="year-tabs" role="tablist">
    {
      recommendedBooks.length > 0 && (
        <button
          class="year-tab recommend-tab"
          data-year="recommend"
          aria-pressed={defaultTab === "recommend" ? "true" : "false"}
          aria-label="추천"
          title="추천"
        >
          <svg
            width="16"
            height="16"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z" />
          </svg>
        </button>
      )
    }
    {
      years.map((year) => (
        <button
          class="year-tab"
          data-year={year}
          aria-pressed={String(year) === defaultTab ? "true" : "false"}
        >
          {year}
        </button>
      ))
    }
  </div>

  {
    recommendedBooks.length > 0 && (
      <div class="year-group recommend-group" data-year="recommend" hidden={defaultTab !== "recommend"}>
        <div class="recommend-header">
          <div class="recommend-title">
            <span class="line" />
            <span class="recommend-label">
              <svg
                width="14"
                height="14"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z" />
                <path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z" />
              </svg>
              you might like
            </span>
            <span class="line" />
          </div>
          <div class="recommend-subtitle">(not an algorithm, just me.)</div>
          {showRefresh && (
            <div class="reroll-wrap">
              <svg
                class="nudge-arrow nudge-left"
                width="12"
                height="12"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2.5"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <path d="M9 6l6 6-6 6" />
              </svg>
              <button class="reroll-btn" type="button" aria-label="Reroll" title="Reroll">
                <svg
                  class="dice-icon"
                  width="26"
                  height="26"
                  viewBox="0 0 24 24"
                  stroke="currentColor"
                >
                  <rect
                    x="2.5"
                    y="2.5"
                    width="19"
                    height="19"
                    rx="5"
                    fill="var(--chip-bg)"
                    stroke-width="1.6"
                  />
                  <path
                    d="M5.3 8.8C5.9 6.2 8 4.2 10.6 3.7"
                    fill="none"
                    stroke-opacity="0.18"
                    stroke-width="1.8"
                    stroke-linecap="round"
                  />
                  <circle cx="8.2" cy="8.2" r="1.7" fill="currentColor" stroke="none" />
                  <circle cx="15.8" cy="8.2" r="1.7" fill="currentColor" stroke="none" />
                  <circle cx="8.2" cy="15.8" r="1.7" fill="currentColor" stroke="none" />
                  <circle cx="15.8" cy="15.8" r="1.7" fill="currentColor" stroke="none" />
                  <circle cx="12" cy="12" r="1.7" fill="currentColor" stroke="none" />
                </svg>
              </button>
              <svg
                class="nudge-arrow nudge-right"
                width="12"
                height="12"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2.5"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <path d="M15 6l-6 6 6 6" />
              </svg>
            </div>
          )}
        </div>
        <ul class="book-list recommend-list">
          {recommendedBooks.map((b) => {
            const text = previewText(b.body ?? "");
            return (
              <li class="book-row recommend-row" hidden>
                <a
                  class="book-link"
                  href={`/books/${b.id}`}
                  data-empty={text ? undefined : "true"}
                >
                  <div class="book-left">
                    <div class="book-title">{b.data.title}</div>
                    {b.data.author && <div class="book-author">{b.data.author}</div>}
                  </div>
                  <div class="book-chip">
                    {text && <span class="chip-text">{text}</span>}
                    <svg
                      class="more-icon"
                      hidden={!!text}
                      width="15"
                      height="15"
                      viewBox="0 0 24 24"
                      fill="currentColor"
                    >
                      <circle cx="5" cy="12" r="2" />
                      <circle cx="12" cy="12" r="2" />
                      <circle cx="19" cy="12" r="2" />
                    </svg>
                  </div>
                </a>
              </li>
            );
          })}
        </ul>
      </div>
    )
  }

  {
    years.map((year) => (
      <div class="year-group" data-year={year} hidden={String(year) !== defaultTab}>
        <div class="year-count">
          <span class="line" />
          <span class="count-badge">
            <svg
              width="14"
              height="14"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z" />
              <path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z" />
            </svg>
            total {byYear[year]!.length}
          </span>
          <span class="line" />
          <button
            class="sort-btn"
            type="button"
            data-order="desc"
            aria-label="Sort by date"
            title="Sort by date"
          >
            <svg
              width="14"
              height="14"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <path d="M12 5v14" />
              <path d="m19 12-7 7-7-7" />
            </svg>
          </button>
        </div>
        <ul class="book-list">
          {byYear[year]!.map((b) => {
            const text = previewText(b.body ?? "");
            return (
              <li class="book-row">
                <a
                  class="book-link"
                  href={`/books/${b.id}`}
                  data-empty={text ? undefined : "true"}
                >
                  <div class="book-left">
                    <div class="book-title">{b.data.title}</div>
                    {b.data.author && <div class="book-author">{b.data.author}</div>}
                  </div>
                  <div class="book-chip">
                    {text && <span class="chip-text">{text}</span>}
                    <svg
                      class="more-icon"
                      hidden={!!text}
                      width="15"
                      height="15"
                      viewBox="0 0 24 24"
                      fill="currentColor"
                    >
                      <circle cx="5" cy="12" r="2" />
                      <circle cx="12" cy="12" r="2" />
                      <circle cx="19" cy="12" r="2" />
                    </svg>
                  </div>
                </a>
              </li>
            );
          })}
        </ul>
        <button class="load-more"><span class="more-text">more</span></button>
      </div>
    ))
  }

  <div class="toast" role="status"></div>
</Layout>

<style>
  .year-tabs {
    display: flex;
    column-gap: 1.1rem;
    row-gap: 0.2rem;
    margin-bottom: 1rem;
    flex-wrap: wrap;
  }
  .year-tab {
    background: none;
    background-repeat: no-repeat;
    border: none;
    padding: 0.1rem 0.15rem;
    font-family: var(--font-sans);
    font-size: 0.95rem;
    color: var(--muted);
    cursor: pointer;
  }
  .year-tab:hover {
    color: var(--fg);
  }
  .year-tab[aria-pressed="true"] {
    color: var(--fg);
    background-image: linear-gradient(
      180deg,
      transparent 0%,
      transparent 35%,
      var(--tab-highlight) 35%,
      var(--tab-highlight) 80%,
      transparent 80%
    );
  }
  .recommend-tab {
    display: inline-flex;
    align-items: center;
  }
  .recommend-tab[aria-pressed="true"] svg {
    fill: currentColor;
  }

  .year-count {
    position: relative;
    display: flex;
    align-items: center;
    gap: 1rem;
    margin: 0 0 1.5rem;
  }
  .sort-btn {
    position: absolute;
    right: 0;
    top: 50%;
    transform: translateY(-50%);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 1.6rem;
    height: 1.6rem;
    border: none;
    background: none;
    color: var(--muted);
    cursor: pointer;
  }
  .sort-btn:hover {
    color: var(--fg);
  }
  .sort-btn svg {
    transition: transform 0.25s ease;
  }
  .sort-btn[data-order="asc"] svg {
    transform: rotate(180deg);
  }
  .year-count .line {
    flex: 1;
    height: 0;
    border-top: 1px dotted var(--border);
  }
  .count-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-family: var(--font-mono);
    font-weight: 400;
    color: var(--muted);
    font-size: 0.85rem;
    white-space: nowrap;
  }

  .recommend-header {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0;
    margin: 0 0 1.5rem;
  }
  .recommend-title {
    display: flex;
    align-items: center;
    gap: 1rem;
    width: 100%;
  }
  .recommend-title .line {
    flex: 1;
    height: 0;
    border-top: 1px dotted var(--border);
  }
  .recommend-label {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-family: var(--font-mono);
    font-weight: 400;
    color: var(--muted);
    font-size: 0.85rem;
    white-space: nowrap;
  }
  .recommend-subtitle {
    align-self: flex-end;
    margin-top: -0.35rem;
    font-family: var(--font-mono);
    font-style: italic;
    font-size: 0.72rem;
    color: var(--muted);
    opacity: 0.7;
  }
  .reroll-wrap {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.35rem;
    margin-top: 0.55rem;
  }
  .nudge-arrow {
    color: var(--muted);
    opacity: 0.5;
  }
  .nudge-arrow.nudge-left {
    animation: nudge-left 1.4s ease-in-out infinite;
  }
  .nudge-arrow.nudge-right {
    animation: nudge-right 1.4s ease-in-out infinite;
  }
  @keyframes nudge-left {
    0%,
    100% {
      transform: translateX(0);
      opacity: 0.4;
    }
    50% {
      transform: translateX(3px);
      opacity: 1;
    }
  }
  @keyframes nudge-right {
    0%,
    100% {
      transform: translateX(0);
      opacity: 0.4;
    }
    50% {
      transform: translateX(-3px);
      opacity: 1;
    }
  }
  .reroll-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.6rem;
    height: 2.6rem;
    border: none;
    border-radius: 50%;
    background: none;
    color: var(--muted);
    cursor: pointer;
    transition:
      transform 0.2s ease,
      color 0.2s ease;
  }
  .reroll-btn:hover {
    color: var(--fg);
    transform: translateY(-2px) scale(1.08);
  }
  .reroll-btn:active {
    transform: translateY(0) scale(0.95);
  }
  .reroll-btn .dice-icon {
    filter: drop-shadow(0 2px 3px rgba(0, 0, 0, 0.18));
  }
  .reroll-btn.spin .dice-icon {
    animation: dice-spin 0.4s ease;
  }
  @keyframes dice-spin {
    from {
      transform: rotate(0deg);
    }
    to {
      transform: rotate(360deg);
    }
  }

  .book-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .book-row {
    border-bottom: 1px solid var(--border);
  }
  .book-row:first-child {
    border-top: 1px solid var(--border);
  }
  .book-row[hidden] {
    display: none;
  }
  .book-link {
    display: grid;
    grid-template-columns: 9rem 26rem;
    column-gap: 1.5rem;
    align-items: start;
    padding: 0.9rem 0;
    text-decoration: none;
    color: inherit;
  }
  .book-left {
    min-width: 0;
  }
  .book-title {
    font-weight: 600;
    font-size: 0.92rem;
    line-height: 1.35;
  }
  .book-author {
    margin-top: 0.3rem;
    font-family: var(--font-mono);
    font-weight: 400;
    color: var(--muted);
    font-size: 0.75rem;
  }
  .book-chip {
    min-width: 0;
    border: 1px solid var(--border);
    border-radius: 3px;
    background-color: var(--chip-bg);
    padding: 0.5rem 0.7rem;
    font-size: 0.8rem;
    line-height: 1.6;
  }
  .chip-text {
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 7;
    line-clamp: 7;
    overflow: hidden;
    text-overflow: clip;
  }
  .book-chip .more-icon {
    display: block;
    margin-top: 0.4rem;
    color: var(--muted);
  }
  .book-chip .more-icon[hidden] {
    display: none;
  }
  .book-link:hover .book-title {
    color: var(--accent);
  }

  .load-more {
    display: flex;
    align-items: center;
    justify-content: center;
    width: fit-content;
    margin: 1.5rem auto 0;
    padding: 0.22rem 0.65rem;
    border: 1px solid var(--border);
    border-radius: 0;
    appearance: none;
    -webkit-appearance: none;
    background: none;
    font-family: var(--font-mono);
    font-size: 0.9rem;
    color: var(--fg);
    cursor: pointer;
  }
  .load-more:hover {
    border-color: var(--fg);
  }
  .load-more[hidden] {
    display: none;
  }

  @media (max-width: 600px) {
    .book-link {
      grid-template-columns: 1fr;
      row-gap: 0.5rem;
    }
    .book-chip {
      width: 100%;
    }
    .recommend-subtitle {
      align-self: center;
      margin-top: 0.3rem;
    }
  }

  .toast {
    position: fixed;
    left: 0;
    top: 0;
    transform: translate(-50%, calc(-100% - 0.6rem)) translateY(0.4rem);
    border: 1px solid var(--border);
    background: var(--chip-bg);
    color: var(--fg);
    padding: 0.5rem 0.9rem;
    font-family: var(--font-mono);
    font-size: 0.8rem;
    white-space: nowrap;
    opacity: 0;
    pointer-events: none;
    transition:
      opacity 0.15s ease,
      transform 0.15s ease;
    z-index: 10;
  }
  .toast.show {
    opacity: 1;
    transform: translate(-50%, calc(-100% - 0.6rem)) translateY(0);
  }
</style>

<script>
  const PAGE_SIZE = 10;

  const tabs = document.querySelectorAll<HTMLButtonElement>(".year-tab");
  const groups = document.querySelectorAll<HTMLDivElement>(".year-group");

  function updateMoreIcons() {
    document.querySelectorAll<HTMLElement>(".chip-text").forEach((el) => {
      if (el.closest<HTMLElement>(".year-group")!.hidden) return;
      if (el.closest<HTMLElement>(".book-row")!.hidden) return;
      const icon = el.parentElement!.querySelector<HTMLElement>(".more-icon")!;
      icon.hidden = el.scrollHeight <= el.clientHeight + 1;
    });
  }

  function showYear(year: string) {
    groups.forEach((g) => {
      g.hidden = g.dataset.year !== year;
    });
    tabs.forEach((t) => {
      t.setAttribute("aria-pressed", String(t.dataset.year === year));
    });
    updateMoreIcons();
  }

  tabs.forEach((tab) => {
    tab.addEventListener("click", () => {
      const year = tab.dataset.year!;
      showYear(year);
      history.replaceState(null, "", `#${year}`);
    });
  });

  const hashYear = location.hash.slice(1);
  if (hashYear && [...tabs].some((t) => t.dataset.year === hashYear)) {
    showYear(hashYear);
  }

  groups.forEach((group) => {
    const btn = group.querySelector<HTMLButtonElement>(".load-more");
    if (!btn) return;
    const list = group.querySelector<HTMLUListElement>(".book-list")!;
    const rows = Array.from(group.querySelectorAll<HTMLLIElement>(".book-row"));
    let visible = PAGE_SIZE;

    function render() {
      rows.forEach((row, i) => {
        row.hidden = i >= visible;
      });
      btn!.hidden = visible >= rows.length;
      updateMoreIcons();
    }

    btn.addEventListener("click", () => {
      visible += PAGE_SIZE;
      render();
    });

    const sortBtn = group.querySelector<HTMLButtonElement>(".sort-btn");
    sortBtn?.addEventListener("click", () => {
      sortBtn.dataset.order = sortBtn.dataset.order === "desc" ? "asc" : "desc";
      rows.reverse();
      rows.forEach((row) => list.appendChild(row));
      visible = PAGE_SIZE;
      render();
    });

    render();
  });

  const recommendGroup = document.querySelector<HTMLDivElement>(".recommend-group");
  if (recommendGroup) {
    const RECOMMEND_COUNT = 10;
    const rows = Array.from(recommendGroup.querySelectorAll<HTMLLIElement>(".recommend-row"));
    const refreshBtn = recommendGroup.querySelector<HTMLButtonElement>(".reroll-btn");

    function pickRandom() {
      const indices = rows.map((_, i) => i);
      for (let i = indices.length - 1; i > 0; i--) {
        const j = Math.floor(Math.random() * (i + 1));
        [indices[i], indices[j]] = [indices[j], indices[i]];
      }
      const chosen = new Set(indices.slice(0, RECOMMEND_COUNT));
      rows.forEach((row, i) => {
        row.hidden = !chosen.has(i);
      });
      updateMoreIcons();
    }

    refreshBtn?.addEventListener("click", () => {
      refreshBtn.classList.add("spin");
      pickRandom();
      setTimeout(() => refreshBtn.classList.remove("spin"), 400);
    });

    pickRandom();
  }

  const toast = document.querySelector<HTMLDivElement>(".toast")!;
  let toastTimer: ReturnType<typeof setTimeout>;

  function showToast(message: string, x: number, y: number) {
    toast.textContent = message;
    toast.style.left = `${x}px`;
    toast.style.top = `${y}px`;
    toast.classList.add("show");
    clearTimeout(toastTimer);
    toastTimer = setTimeout(() => toast.classList.remove("show"), 1600);
  }

  document.querySelectorAll<HTMLAnchorElement>(".book-link[data-empty]").forEach((link) => {
    link.addEventListener("click", (e) => {
      e.preventDefault();
      showToast("📭 this page doesn't exist", e.clientX, e.clientY);
    });
  });

  updateMoreIcons();
  document.fonts.ready.then(updateMoreIcons);
  let resizeTimer: ReturnType<typeof setTimeout>;
  window.addEventListener("resize", () => {
    clearTimeout(resizeTimer);
    resizeTimer = setTimeout(updateMoreIcons, 150);
  });
</script>
