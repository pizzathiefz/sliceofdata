---
import Layout from "../../layouts/Layout.astro";
import Shelf from "../../components/Shelf.astro";
import { getCollection, render } from "astro:content";

export async function getStaticPaths() {
  const books = await getCollection("books");
  return books.map((book) => ({
    params: { slug: book.id },
    props: { book },
  }));
}

const { book } = Astro.props;
const { Content } = await render(book);
const allBooks = await getCollection("books");
const related = book.data.related
  .map((slug) => allBooks.find((b) => b.id === slug))
  .filter((b) => b != null);

const splitAuthors = (author?: string) =>
  (author ?? "")
    .split(",")
    .map((n) => n.trim())
    .filter(Boolean);

// Up to three authors become buttons that list every book by them.
const authorNames = splitAuthors(book.data.author);
const shownAuthors = authorNames.slice(0, 3);
const booksByAuthor = shownAuthors.map((name) => ({
  name,
  books: allBooks
    .filter((b) => splitAuthors(b.data.author).includes(name))
    .sort((a, b) => b.data.created.getTime() - a.data.created.getTime()),
}));

function formatAuthors(author?: string) {
  if (!author) return author;
  const names = author
    .split(",")
    .map((n) => n.trim())
    .filter(Boolean);
  if (names.length <= 3) return author;
  return `${names.slice(0, 3).join(", ")} 외 ${names.length - 3}인`;
}

const metaParts = [
  book.data.publisher,
  book.data.yearOfPublication,
  book.data.originalTitle,
].filter((v) => v != null && v !== "");

const bookYear = book.data.created.getFullYear();
const readDateIso = book.data.created.toISOString().slice(0, 10);
const readDateLabel = readDateIso.replace(/-/g, ".");
---

<Layout title={book.data.title}>
  <a class="back" href={`/books#${bookYear}`}>← books</a>
  <h1>{book.data.title}</h1>
  <div class="book-meta">
    {(shownAuthors.length > 0 || metaParts.length > 0) && (
      <p>
        {shownAuthors.map((name, i) => (
          <Fragment>
            {i > 0 && ", "}
            <button type="button" class="tag-link" data-author={name}>
              {name}
            </button>
          </Fragment>
        ))}
        {authorNames.length > 3 && ` 외 ${authorNames.length - 3}인`}
        {shownAuthors.length > 0 && metaParts.length > 0 && " · "}
        {metaParts.join(" · ")}
      </p>
    )}
    <p class="read-date"><time datetime={readDateIso}>{readDateLabel} 읽음</time></p>
  </div>
  <article>
    <Content />
  </article>
  {
    booksByAuthor.map(({ name, books }) => (
      <template data-author-books={name}>
        {books.map((b) => (
          <a
            href={`/books/${b.id}`}
            class="modal-item"
            aria-current={b.id === book.id ? "page" : undefined}
          >
            <span class="modal-item-title">{b.data.title}</span>
            <span class="modal-item-date">
              {b.data.created.toISOString().slice(0, 10).replace(/-/g, ".")}
            </span>
          </a>
        ))}
      </template>
    ))
  }
  <Shelf
    label="more from the shelf"
    icon="books"
    shuffle
    items={related.map((b) => ({
      href: `/books/${b.id}`,
      title: b.data.title,
      meta: formatAuthors(b.data.author),
    }))}
  />
</Layout>

<style>
  .book-meta {
    text-align: right;
    color: var(--muted);
    margin: 0.4rem 0 2rem;
  }
  .book-meta p {
    margin: 0;
    font-size: 0.85rem;
  }
  .book-meta .read-date {
    margin-top: 0.2rem;
    font-size: 0.78rem;
    font-variant-numeric: tabular-nums;
  }
</style>
