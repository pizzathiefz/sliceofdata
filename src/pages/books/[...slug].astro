---
import Layout from "../../layouts/Layout.astro";
import { getCollection, render } from "astro:content";

export async function getStaticPaths() {
  const books = await getCollection("books");
  return books.map((book) => ({
    params: { slug: book.id },
    props: { book },
  }));
}

const { book } = Astro.props;
const { Content } = await render(book);

function formatAuthors(author?: string) {
  if (!author) return author;
  const names = author
    .split(",")
    .map((n) => n.trim())
    .filter(Boolean);
  if (names.length <= 3) return author;
  return `${names.slice(0, 3).join(", ")} 외 ${names.length - 3}인`;
}

const metaParts = [
  formatAuthors(book.data.author),
  book.data.publisher,
  book.data.yearOfPublication,
  book.data.originalTitle,
].filter((v) => v != null && v !== "");

const bookYear = book.data.created.getFullYear();
---

<Layout title={book.data.title}>
  <a class="back" href={`/books#${bookYear}`}>← books</a>
  <h1>{book.data.title}</h1>
  {metaParts.length > 0 && <p class="book-meta">{metaParts.join(" · ")}</p>}
  <article>
    <Content />
  </article>
</Layout>

<style>
  .book-meta {
    text-align: right;
    color: var(--muted);
    font-size: 0.85rem;
    margin: 0.4rem 0 2rem;
  }
</style>
