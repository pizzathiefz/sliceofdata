---
import Layout from "../../layouts/Layout.astro";
import Comments from "../../components/Comments.astro";
import Shelf from "../../components/Shelf.astro";
import { getCollection, render } from "astro:content";
import { RELATED_LABEL, relatedShelfItems } from "../../lib/related-notes";

export async function getStaticPaths() {
  const posts = await getCollection("posts");
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const related = await relatedShelfItems(post.data.related);

const writtenDateIso = post.data.created.toISOString().slice(0, 10);
const writtenDateLabel = writtenDateIso.replace(/-/g, ".");
---

<Layout title={post.data.title}>
  <a class="back" href="/posts">← posts</a>
  <h1>{post.data.title}</h1>
  <div class="post-meta">
    {post.data.tags.length > 0 && (
      <p>
        {post.data.tags.map((tag, i) => (
          <Fragment>
            {i > 0 && ", "}
            <button type="button" class="tag-link" data-tag={tag}>
              {tag}
            </button>
          </Fragment>
        ))}
      </p>
    )}
    <p class="written-date"><time datetime={writtenDateIso}>{writtenDateLabel} 씀</time></p>
  </div>
  <article>
    <Content />
  </article>
  <Shelf label={RELATED_LABEL} icon="notebook" items={related} />
  <Comments path={Astro.url.pathname} />
</Layout>

<style>
  .post-meta {
    text-align: right;
    color: var(--muted);
    margin: 0.4rem 0 2rem;
  }
  .post-meta p {
    margin: 0;
    font-size: 0.85rem;
  }
  .post-meta .written-date {
    margin-top: 0.2rem;
    font-size: 0.78rem;
    font-variant-numeric: tabular-nums;
  }
</style>
