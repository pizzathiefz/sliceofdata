---
import Layout from "../../layouts/Layout.astro";
import { getCollection } from "astro:content";

const notes = (await getCollection("notes", ({ data }) => data.publish)).sort(
  (a, b) => b.data.created.valueOf() - a.data.created.valueOf()
);

function splitAtSuffix(title: string) {
  const m = title.match(/^(.*?)(\s@.+)$/);
  if (!m) return { main: title, suffix: null };
  return { main: m[1], suffix: m[2] };
}
---

<Layout title="notes">
  <h1>notes</h1>
  <ul class="rows">
    {
      notes.map((note) => {
        const { main, suffix } = splitAtSuffix(note.data.title);
        return (
          <li class="row">
            <a class="row-title" href={`/notes/${note.id}`}>
              {main}
              {suffix && <span class="title-suffix">{suffix}</span>}
            </a>
            <time class="row-meta">{note.data.created.toISOString().slice(2, 10).replace(/-/g, ".")}</time>
          </li>
        );
      })
    }
  </ul>
  <button class="load-more"><span class="more-text">more</span></button>
</Layout>

<style>
  ul.rows li.row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.6em;
    padding: 0.5rem 0;
  }
  ul.rows li.row[hidden] {
    display: none;
  }
  ul.rows .row-title {
    flex: 1 1 auto;
    min-width: 0;
    font-size: 0.85rem;
    line-height: 1.55;
    white-space: normal;
    overflow: visible;
    text-overflow: clip;
  }
  .title-suffix {
    color: var(--muted);
  }
  ul.rows .row-meta {
    flex: 0 0 auto;
    line-height: 1;
    padding: 0.05em 0.35em;
    font-size: 0.75rem;
    background-image: linear-gradient(
      180deg,
      transparent 0%,
      transparent 35%,
      var(--tab-highlight) 35%,
      var(--tab-highlight) 80%,
      transparent 80%
    );
    background-repeat: no-repeat;
  }
  .load-more {
    display: flex;
    align-items: center;
    justify-content: center;
    width: fit-content;
    margin: 1.5rem auto 0;
    padding: 0.22rem 0.65rem;
    border: 1px solid var(--border);
    border-radius: 0;
    appearance: none;
    -webkit-appearance: none;
    background: none;
    font-family: var(--font-mono);
    font-size: 0.9rem;
    color: var(--fg);
    cursor: pointer;
  }
  .load-more:hover {
    border-color: var(--fg);
  }
  .load-more[hidden] {
    display: none;
  }
</style>

<script>
  const PAGE_SIZE = 15;
  const rows = Array.from(document.querySelectorAll<HTMLLIElement>(".row"));
  const btn = document.querySelector<HTMLButtonElement>(".load-more")!;
  let visible = PAGE_SIZE;

  function render() {
    rows.forEach((row, i) => {
      row.hidden = i >= visible;
    });
    btn.hidden = visible >= rows.length;
  }

  btn.addEventListener("click", () => {
    visible += PAGE_SIZE;
    render();
  });

  render();
</script>
