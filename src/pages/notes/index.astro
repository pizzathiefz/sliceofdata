---
import Layout from "../../layouts/Layout.astro";
import { getCollection } from "astro:content";

const notes = (await getCollection("notes", ({ data }) => data.publish)).sort(
  (a, b) => b.data.created.valueOf() - a.data.created.valueOf()
);

function splitAtSuffix(title: string) {
  const m = title.match(/^(.*?)(\s@.+)$/);
  if (!m) return { main: title, suffix: null };
  return { main: m[1], suffix: m[2] };
}
---

<Layout title="notes">
  <h1>notes</h1>
  <ul class="rows">
    {
      notes.map((note) => {
        const { main, suffix } = splitAtSuffix(note.data.title);
        return (
          <li class="row">
            <a class="row-title" href={`/notes/${note.id}`}>
              {main}
              {suffix && <span class="title-suffix">{suffix}</span>}
            </a>
            <time class="row-meta">{note.data.created.toISOString().slice(0, 10).replace(/-/g, ".")}</time>
          </li>
        );
      })
    }
  </ul>
  <div class="pagination-info">{Math.min(15, notes.length)}/{notes.length}</div>
  <button class="load-more" aria-label="더 보기" title="더 보기">
    <svg
      width="14"
      height="14"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
    >
      <path d="M6 9l6 6 6-6" />
    </svg>
  </button>
</Layout>

<style>
  h1 {
    display: none;
  }
  ul.rows {
    margin-top: -1.5rem;
  }
  ul.rows li.row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.6em;
    padding: 0.5rem 0;
  }
  ul.rows li.row[hidden] {
    display: none;
  }
  ul.rows .row-title {
    flex: 1 1 auto;
    min-width: 0;
    font-size: 0.85rem;
    line-height: 1.55;
    white-space: normal;
    overflow: visible;
    text-overflow: clip;
    font-family: "Pretendard", -apple-system, BlinkMacSystemFont, "Segoe UI", Helvetica, Arial, sans-serif;
  }
  .title-suffix {
    color: var(--muted);
  }
  ul.rows .row-meta {
    flex: 0 0 auto;
    line-height: 1;
    padding: 0.05em 0.35em;
    font-size: 0.75rem;
  }
  .pagination-info {
    margin: 0.6rem 0 0;
    text-align: right;
    font-family: var(--font-mono);
    font-weight: 400;
    color: var(--muted);
    font-size: 0.75rem;
  }
  .load-more {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 1.9rem;
    height: 1.9rem;
    margin: 0.75rem auto 0;
    padding: 0;
    border: 1px solid var(--border);
    border-radius: 999px;
    appearance: none;
    -webkit-appearance: none;
    background: none;
    color: var(--muted);
    cursor: pointer;
    transition:
      color 0.25s ease,
      border-color 0.25s ease;
  }
  .load-more:hover {
    color: var(--accent);
    border-color: var(--accent);
  }
  .load-more[hidden] {
    display: none;
  }
</style>

<script>
  const PAGE_SIZE = 15;
  const rows = Array.from(document.querySelectorAll<HTMLLIElement>(".row"));
  const btn = document.querySelector<HTMLButtonElement>(".load-more")!;
  const info = document.querySelector<HTMLDivElement>(".pagination-info")!;
  let visible = PAGE_SIZE;

  function render() {
    rows.forEach((row, i) => {
      row.hidden = i >= visible;
    });
    btn.hidden = visible >= rows.length;
    info.textContent = `${Math.min(visible, rows.length)}/${rows.length}`;
  }

  btn.addEventListener("click", () => {
    visible += PAGE_SIZE;
    render();
  });

  render();
</script>
