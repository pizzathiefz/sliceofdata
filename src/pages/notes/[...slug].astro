---
import Layout from "../../layouts/Layout.astro";
import Shelf from "../../components/Shelf.astro";
import { getCollection, render } from "astro:content";
import { RELATED_LABEL, relatedShelfItems } from "../../lib/related-notes";

export async function getStaticPaths() {
  const notes = await getCollection("notes", ({ data }) => data.publish);
  return notes.map((note) => ({
    params: { slug: note.id },
    props: { note },
  }));
}

const { note } = Astro.props;
const { Content } = await render(note);
const related = await relatedShelfItems(note.data.related);

const titleMatch = note.data.title.match(/^(.*?)(\s@.+)$/);
const titleMain = titleMatch ? titleMatch[1] : note.data.title;
const titleSuffix = titleMatch ? titleMatch[2] : null;

const writtenDateIso = note.data.created.toISOString().slice(0, 10);
const writtenDateLabel = writtenDateIso.replace(/-/g, ".");
---

<Layout title={note.data.title}>
  <a class="back" href="/notes">← notes</a>
  <h1>
    {titleMain}
    {titleSuffix && <span class="title-suffix">{titleSuffix}</span>}
  </h1>
  <div class="note-meta">
    {note.data.tags.length > 0 && (
      <p>
        {note.data.tags.map((tag, i) => (
          <Fragment>
            {i > 0 && ", "}
            <button type="button" class="tag-link" data-tag={tag}>
              {tag}
            </button>
          </Fragment>
        ))}
      </p>
    )}
    <p class="written-date"><time datetime={writtenDateIso}>{writtenDateLabel} 씀</time></p>
  </div>
  <article>
    <Content />
  </article>
  <Shelf label={RELATED_LABEL} icon="notebook" items={related} />
</Layout>

<style>
  h1 {
    font-family: "Pretendard", -apple-system, BlinkMacSystemFont, "Segoe UI", Helvetica, Arial,
      sans-serif;
  }
  .title-suffix {
    color: var(--muted);
  }
  .note-meta {
    text-align: right;
    color: var(--muted);
    margin: 0.4rem 0 2rem;
  }
  .note-meta p {
    margin: 0;
    font-size: 0.85rem;
  }
  .note-meta .written-date {
    margin-top: 0.2rem;
    font-size: 0.78rem;
    font-variant-numeric: tabular-nums;
  }
</style>
