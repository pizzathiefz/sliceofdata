# Path to a local checkout of the `notes` vault repo (its `content/` and
# `assets/` folders). Defaults to the iCloud-synced Obsidian vault when unset —
# only needed in CI, where it should point at wherever the vault repo was
# freshly cloned before `npm run build` (which runs the sync automatically).
VAULT_PATH=/Users/yshin/Library/Mobile Documents/iCloud~md~obsidian/Documents/notes
